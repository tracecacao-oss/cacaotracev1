# Copiar a backend/.env (que nunca se sube al repositorio).
# Los valores de abajo son solo para desarrollo local; los secretos se dejan vacíos.
# En producción todas estas variables viven en el panel de Render.

ENVIRONMENT=development

# Postgres de docker-compose. En Render: cadena del pooler de Supabase en modo sesión.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cacaotrace

# Proyecto real de Supabase (el inicio de sesión en local usa el proyecto real).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Solo si el proyecto firma tokens con HS256 (secreto compartido).
SUPABASE_JWT_SECRET=

STORAGE_BUCKET=documentos
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PRODUCTOR_EMAIL_DOMAIN=productores.cacaotrace.local
GIT_SHA=local

# Parte 4: fuentes del análisis de cobertura forestal. Vacías = fuente "no configurada".
WHISP_API_KEY=
GFW_API_KEY=
ANALISIS_VIGENCIA_DIAS=180
AVISO_VENCIMIENTO_DIAS=30
# Adenda de la Parte 4: MapBiomas Perú (archivos públicos, sin clave) y umbral de "registra bosque en 2020".
# En local queda apagado; en Render está en true desde que pasó la comprobación de viabilidad.
MAPBIOMAS_ACTIVO=false
MAPBIOMAS_ANIO_INICIAL=2015
MAPBIOMAS_ANIO_FINAL=2024
UMBRAL_BOSQUE_2020_PCT=10

# Adenda 2 de la Parte 4: imágenes de Sentinel-2 por Copernicus Data Space. Vacías = "no configurada":
# no se generan imágenes. Esri Wayback es público y no pide clave.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
IMAGENES_NUBES_MAX_PCT=5
IMAGENES_MARGEN_M=150
IMAGENES_CUOTA_MENSUAL_PU=10000

# Parte 10: límites del plan de Supabase para el control de espacio (MB).
LIMITE_STORAGE_MB=1024
LIMITE_DB_MB=500

# Adenda 4: legalidad de la parcela. Vigencia de la declaración jurada de tenencia (meses), distancia al
# agua que se considera "colinda" (metros) y capas oficiales que se cruzan (públicas, sin clave).
DECLARACION_VIGENCIA_MESES=12
# Adenda 5: la declaración anual del productor vale estos meses desde que se declaró.
DECLARACION_PRODUCTOR_VIGENCIA_MESES=12
# Adenda 6: vencimiento de la declaración de renta de la organización y vigencia de una actuación (meses).
RENTA_VIGENCIA_MESES=18
ACTUACION_VIGENCIA_MESES=12
# Adenda 7: diferencia de peso (%) entre la declaración aduanera y el lote desde la que se dice "difiere".
DAM_TOLERANCIA_PESO_PCT=1
DISTANCIA_CUERPO_AGUA_M=100
CAPAS_LEGALES_ACTIVAS=sernanp_anp,sernanp_amortiguamiento,serfor_zonificacion,idep_comunidades,ign_hidrografia,sigda_monumentos

# Parte 5: dirección de la interfaz a la que lleva el código QR de cada DOP.
URL_INTERFAZ=http://localhost:5500
