# Copiar a backend/.env (que nunca se sube al repositorio).
# Los valores de abajo son solo para desarrollo local; los secretos se dejan vacíos.
# En producción todas estas variables viven en el panel de Render.

ENVIRONMENT=development

# Postgres de docker-compose. En Render: cadena del pooler de Supabase en modo sesión.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cacaotrace

# Proyecto real de Supabase (el inicio de sesión en local usa el proyecto real).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Solo si el proyecto firma tokens con HS256 (secreto compartido).
SUPABASE_JWT_SECRET=

STORAGE_BUCKET=documentos
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PRODUCTOR_EMAIL_DOMAIN=productores.cacaotrace.local
GIT_SHA=local
